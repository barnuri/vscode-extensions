{
    "name": "python-import-helper",
    "displayName": "Python Import Helper",
    "description": "Automatically generate import statements for Python.",
    "publisher": "Bar",
    "version": "1.0.35",
    "scripts": {
        "vscode:prepublish": "npm run typecheck && npm run build -- --minify",
        "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
        "typecheck": "tsc -p . --noEmit",
        "compile": "npm run typecheck && npm run build",
        "watch": "npm run build -- --watch",
        "test": "tsc -p tests && node --require ./tests/vscodeStub.js --test \"out-test/tests/*.test.js\"",
        "gitBeforePublish": "npm version patch && git add . && git commit -m \"version\" --allow-empty && git push",
        "publish": "npm run gitBeforePublish && vsce publish"
    },
    "keywords": [
        "python import helper",
        "python",
        "import helper",
        "python auto imports",
        "auto imports",
        "Nuri",
        "BarNuri",
        "nuri",
        "bar",
        "barnuri"
    ],
    "categories": [
        "Programming Languages",
        "Snippets",
        "Formatters",
        "Other"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/barnuri/vscode-extensions"
    },
    "icon": "logo.png",
    "galleryBanner": {
        "color": "#01263F",
        "theme": "dark"
    },
    "activationEvents": [
        "onLanguage:python"
    ],
    "contributes": {
        "commands": [
            {
                "command": "extension.rebuild",
                "title": "Python Import Helper: Rebuild"
            }
        ],
        "configuration": {
            "title": "Python Import Helper",
            "properties": {
                "pythonImportHelper.sourceRoots": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "markdownDescription": "Folders, relative to the workspace root, that hold your top-level packages (for example `src`). The extension removes this prefix from generated import paths. It also reads `package-dir`, `where` and `from` in `pyproject.toml`."
                }
            }
        }
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "main": "./dist/extension.js",
    "dependencies": {
        "lodash": "^4.18.1",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@types/lodash": "^4.17.26",
        "@types/node": "^26.6.5",
        "@types/vscode": "~1.75.0",
        "@vscode/vsce": "^4.0.0",
        "esbuild": "^0.28.2",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2"
    }
}
