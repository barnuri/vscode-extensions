{
    "name": "generator-from-swagger",
    "description": "Generator From Swagger",
    "displayName": "Generator From Swagger",
    "publisher": "Bar",
    "version": "1.1.39",
    "scripts": {
        "vscode:prepublish": "npm run package",
        "package": "npm run typecheck && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --minify --sourcemap=external",
        "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
        "typecheck": "tsc -p . --noEmit",
        "compile": "npm run typecheck && npm run build",
        "watch": "npm run build -- --watch",
        "gitBeforePublish": "npm version patch && git add . && git commit -m \"version\" --allow-empty && git push",
        "publish": "npm run gitBeforePublish && vsce publish",
        "lint": "oxlint src",
        "updateDep": "npm-check-updates -u"
    },
    "contributes": {
        "jsonValidation": [
            {
                "fileMatch": "generator-from-swagger.json",
                "url": "./generator-from-swagger-schema.json"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "extensionView",
                    "title": "Generator From Swagger",
                    "icon": "resources/Swagger2.svg"
                }
            ]
        },
        "views": {
            "extensionView": [
                {
                    "id": "extensionView",
                    "name": "Generator From Swagger"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "extension.refresh",
                    "when": "view == extensionView",
                    "group": "navigation"
                },
                {
                    "command": "extension.edit",
                    "when": "view == extensionView",
                    "group": "navigation"
                },
                {
                    "command": "extension.createConfig",
                    "when": "view == extensionView",
                    "group": "navigation"
                },
                {
                    "command": "extension.info",
                    "when": "view == extensionView",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "extension.generate",
                    "when": "view == extensionView && viewItem == parent",
                    "group": "inline"
                },
                {
                    "command": "extension.generate",
                    "when": "view == extensionView && viewItem == parent"
                }
            ]
        },
        "commands": [
            {
                "command": "extension.refresh",
                "title": "Refresh",
                "icon": {
                    "light": "resources/light/refresh.svg",
                    "dark": "resources/dark/refresh.svg"
                }
            },
            {
                "command": "extension.generate",
                "title": "Generate",
                "icon": {
                    "light": "resources/light/dependency.svg",
                    "dark": "resources/dark/dependency.svg"
                }
            },
            {
                "command": "extension.edit",
                "title": "Edit Config",
                "icon": {
                    "light": "resources/light/edit.svg",
                    "dark": "resources/dark/edit.svg"
                }
            },
            {
                "command": "extension.createConfig",
                "title": "Create Config",
                "icon": {
                    "light": "resources/light/string.svg",
                    "dark": "resources/dark/string.svg"
                }
            },
            {
                "command": "extension.info",
                "title": "Info",
                "icon": {
                    "light": "resources/light/info.svg",
                    "dark": "resources/dark/info.svg"
                }
            }
        ]
    },
    "icon": "icon.png",
    "galleryBanner": {
        "color": "#343a40",
        "theme": "dark"
    },
    "main": "./dist/extension.js",
    "dependencies": {
        "adm-zip": "^0.6.1",
        "axios": "^1.20.0",
        "open": "^11.0.4",
        "openapi-toolkit": "^2.9.0",
        "rimraf": "^6.1.3"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.5",
        "@types/vscode": "~1.75.1",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.0.0",
        "esbuild": "^0.28.2",
        "glob": "^13.0.6",
        "mocha": "^12.0.3",
        "oxlint": "^1.88.0",
        "tslib": "^2.8.1",
        "typescript": "^7.0.2"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/barnuri/vscode-extensions"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "Swagger",
        "Generator",
        "Tools",
        "Bar Nuri",
        "Nuri",
        "Bar",
        "Generator From Swagger",
        "Nuri",
        "BarNuri",
        "nuri",
        "bar",
        "barnuri"
    ],
    "tags": [
        "Swagger",
        "Generator",
        "Tools",
        "Bar Nuri",
        "Nuri",
        "Bar",
        "Generator From Swagger",
        "Nuri",
        "BarNuri",
        "nuri",
        "bar",
        "barnuri"
    ]
}
